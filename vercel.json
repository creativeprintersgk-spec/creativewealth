{
  "rewrites": [
    { "source": "/api/yahoo/(.*)", "destination": "https://query1.finance.yahoo.com/$1" },
    { "source": "/api/gfinance/(.*)", "destination": "https://www.google.com/finance/quote/$1" },
    { "source": "/api/mfapi/(.*)", "destination": "https://api.mfapi.in/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
